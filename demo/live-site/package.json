{
  "name": "copilot-live-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Five fictional demo sites with the real copilot engine wired in, plus the backend that holds the keys.",
  "scripts": {
    "build": "node --no-warnings build.ts",
    "start": "node --no-warnings build.ts && node server.ts",
    "start:offline": "node --no-warnings build.ts && node server.ts --offline",
    "docs": "python3 tools/docs.py",
    "test": "node --no-warnings build.ts && node tests/scenes.ts",
    "test:offline": "node --no-warnings build.ts && node tests/scenes.ts --offline"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
